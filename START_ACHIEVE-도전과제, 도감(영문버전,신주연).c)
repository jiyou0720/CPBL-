    int itemCollection[NUM_ITEMS];

    int ghostAvoidStreak;
    int checkpointCount;
    int trapCount;
    int puzzleFailCount;

    int allPuzzleFirstTry;

    int caughtByButler;

    int collectedJournalCount;

} Player;

