// ============================================
// Journal UI
// ============================================

void showJournalPage(int page)
{
    if(page < 1 || page > NUM_JOURNALS)
        return;

    system("clear");

    printf("=====================================\n");
    printf("        Servant Journal %d\n", page);
    printf("=====================================\n\n");

    printf("%s\n", journalTexts[page - 1]);

    printf("\nPress Enter...");
    getchar();
}
